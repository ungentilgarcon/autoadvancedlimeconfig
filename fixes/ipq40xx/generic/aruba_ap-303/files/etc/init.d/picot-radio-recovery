#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
	enabled=$(uci -q get picot-radio-recovery.settings.enabled) || {
		logger -t picot-radio-recovery "ERROR: missing enabled setting"
		return 1
	}
	case "$enabled" in
		0) return 0;;
		1) ;;
		*) logger -t picot-radio-recovery "ERROR: invalid enabled setting"; return 1;;
	esac
	procd_open_instance
	procd_set_param command /usr/sbin/picot-radio-recovery run
	procd_set_param respawn
	procd_close_instance
}
