# Copy to .pass, chmod 600 .pass, then fill values privately.
# Values are plain text; do not commit .pass or paste it into chat.
#
# Optional shared OpenWrt root password for local --inject-pass builds.
# Use 8-128 printable ASCII characters; blank leaves it unchanged.
OPENWRT_ADMIN_PASSWORD=

# Shared LibreMesh credentials used by Aruba and Redmi builds.
MAIN_WIFI_KEY=
MESH_WIFI_KEY=
AP_HOSTNAME=PICOT-ap-%M4%M5%M6

# Optional, used by fleet-libremesh.py when nodes do not accept SSH keys.
# Needs the sshpass package. FLEET_SSH_PASSWORD applies to every node;
# FLEET_SSH_PASSWORD_<NODE> (node name upper-cased, non-alphanumerics as _)
# overrides it for one node.
FLEET_SSH_PASSWORD=

# Required by deploy-libremesh.py vlans.
IOT_WIFI_KEY=
GUEST_WIFI_KEY=
