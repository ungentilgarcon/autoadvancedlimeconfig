# Copy to .pass, chmod 600 .pass, then fill values privately.
# Values are plain text; do not commit .pass or paste it into chat.
#
# Router admin passwords are not used by the deployment tool; it connects
# with SSH keys and strict host-key checking.
REDMI_ADMIN_PASSWORD=
ARUBA_ADMIN_PASSWORD=

# Shared LibreMesh credentials used by Aruba and Redmi builds.
MAIN_WIFI_KEY=
MESH_WIFI_KEY=
AP_HOSTNAME=PICOT-ap-%M4%M5%M6

# Historical Redmi archive credentials; not used by custom image builds.
REDMI_ARCHIVE_MAIN_WIFI_KEY=
REDMI_ARCHIVE_APNAME_WIFI_KEY=
REDMI_ARCHIVE_MESH_KEY=

# Required by deploy-libremesh.py vlans.
IOT_WIFI_KEY=
GUEST_WIFI_KEY=
